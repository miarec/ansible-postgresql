---
# ansible-lint reads this file too, so the yaml[...] entries in .ansible-lint
# and the rules here should agree. ansible-lint also requires the braces,
# comments, comments-indentation, and octal-values settings below, or it warns
# that the config is incompatible and turns off its fix mode.
extends: default

ignore:
  - .venv/
  - .ansible/

rules:
  # Allow `{ key: value }` with spaces inside the braces. These are also the
  # values ansible-lint requires.
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  colons: disable
  commas: disable
  # .ansible-lint skips yaml[comments]. defaults/main.yml has many banner
  # comments such as `#----`, so only keep the value ansible-lint requires.
  comments:
    min-spaces-from-content: 1
    require-starting-space: false
  comments-indentation: false
  # ansible-lint disables this rule by default, and most task files here
  # start without `---`.
  document-start: disable
  empty-lines: disable
  indentation: disable
  line-length: disable
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  trailing-spaces: disable
  # The role uses `yes`, `no`, `on`, and `off` in several places, and
  # .ansible-lint skips yaml[truthy] for the same reason.
  truthy: disable
